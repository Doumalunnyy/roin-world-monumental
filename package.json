{
  "name": "roin-world-monumental",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/check-content.mjs && next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib tests",
    "test": "node --test tests/*.test.mjs",
    "e2e": "playwright test",
    "cms": "npx --yes decap-server@3.11.6",
    "predev": "node --env-file-if-exists=.env.local scripts/cms-config.mjs",
    "prebuild": "node --env-file-if-exists=.env.local scripts/cms-config.mjs",
    "build:pages": "node --env-file-if-exists=.env.local scripts/build-pages.mjs"
  },
  "dependencies": {
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.0",
    "lighthouse": "^13.0.1",
    "typescript": "~5.9.3"
  }
}
