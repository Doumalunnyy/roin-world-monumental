# Set to the final HTTPS origin before building.
SITE_URL=http://localhost:3000
# Enable only after the operator approves the privacy policy and retention process.
CONTACT_ENABLED=false
# Absolute path outside the public web root, on a persistent, backed-up volume.
CONTACT_INBOX_DIR=

CMS_REPOSITORY=
CMS_BRANCH=main
CMS_OAUTH_BASE_URL=
CMS_AUTH_ENDPOINT=auth
